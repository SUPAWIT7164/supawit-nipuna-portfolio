# raw capture dumps — site uses renamed copies under public/images/projects
/public/images/image (*).png
/public/images/สกรีนช็อต*.png
/public/images/รูป*.png

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
