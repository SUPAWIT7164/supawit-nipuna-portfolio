/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.netlify

# source assets kept outside public/
/agnos.png
/bms.png
/room-booking.png
/Building Management Dashboard.png
/IoT & Access Control Platform.png
